<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/shell_surface</item>
        <item name="android:navigationBarColor">@color/shell_surface</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/shell_background</item>
        <item name="android:colorAccent">@color/shell_selected</item>
        <item name="show_home_divider">2</item>
        <item name="home_bottom_navigation_card_elevation">8dp</item>
        <item name="heading1">@style/TextAppearance.Dr.Headline1</item>
        <item name="heading4">@style/TextAppearance.Dr.Headline4</item>
        <item name="heading5">@style/TextAppearance.Dr.Headline5</item>
        <item name="bodySmall">@style/TextAppearance.Dr.Body2</item>
        <item name="colorOnSurfaceVariant">@android:color/white</item>
        <item name="backgroundColor">@color/n_05</item>
        <item name="colorSurfaceVariant">@color/n_00</item>
        <item name="colorSurfaceVariant5">@color/mb_50</item>
        <item name="colorSurface">@color/white</item>
        <item name="backdrop50">@color/n_00_o_50</item>
        <item name="onSurfaceBgLinks">@color/links</item>
        <item name="onSurfaceBlue">@color/mb_50</item>
        <item name="onSurfaceBgDivider">@color/n_10</item>
        <item name="backgroundVariant2">@color/mb_90</item>
        <item name="colorOnBackground">@color/n_60</item>
        <item name="onBackgroundSurface2">@color/n_50</item>
        <item name="onBackgroundSurface3">@color/n_40</item>
        <item name="onBackgroundSurface5">@color/n_10</item>
        <item name="onSurfaceBgOutline">@color/n_15</item>
        <item name="heading6">@style/TextAppearance.Dr.Headline6</item>
        <item name="subtext1">@style/TextAppearance.Dr.Subtitle1</item>
        <item name="subtext2">@style/TextAppearance.Dr.Subtitle2</item>
    </style>
    <style name="TextAppearance.Dr.Headline1" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="android:textSize">36sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="lineHeight">43sp</item>
    </style>
    <style name="TextAppearance.Dr.Headline4" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="lineHeight">24sp</item>
    </style>
    <style name="TextAppearance.Dr.Headline6" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="lineHeight">19sp</item>
    </style>
    <style name="TextAppearance.Dr.Subtitle1" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="lineHeight">14sp</item>
    </style>
    <style name="TextAppearance.Dr.Subtitle2" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="lineHeight">14sp</item>
    </style>
    <style name="TextAppearance.Dr.Headline5" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="lineHeight">22sp</item>
    </style>
    <style name="TextAppearance.Dr.Body2" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="lineHeight">17sp</item>
    </style>
    <style name="TabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>
    <style name="HorizontalProgressBarVideoDownload" parent="@style/Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:layout_height">2dp</item>
        <item name="android:max">100</item>
        <item name="android:indeterminate">false</item>
        <item name="android:progressDrawable">@drawable/bg_progressbar_blue_background</item>
    </style>
</resources>
