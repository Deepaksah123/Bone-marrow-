<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:background="?attr/colorSurface">

    <ImageView
        android:id="@+id/ivVideoThumbnail"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:contentDescription="@null"
        app:srcCompat="@drawable/ic_marrow_logo_blue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivPlayPlaceholder"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/circle_4d000000"
        android:contentDescription="@null"
        android:paddingStart="8dp"
        android:paddingEnd="6dp"
        android:paddingVertical="6dp"
        app:srcCompat="@drawable/ic_playback_play"
        app:tint="?attr/colorOnPrimary"
        app:layout_constraintBottom_toBottomOf="@id/ivVideoThumbnail"
        app:layout_constraintEnd_toEndOf="@id/ivVideoThumbnail"
        app:layout_constraintStart_toStartOf="@id/ivVideoThumbnail"
        app:layout_constraintTop_toTopOf="@id/ivVideoThumbnail" />

    <ImageView
        android:id="@+id/btnDismiss"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="@null"
        android:padding="4dp"
        app:srcCompat="@drawable/ic_switch_orientation_close"
        app:tint="?attr/onBackgroundSurface3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layoutVideoInfo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="10dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnDismiss"
        app:layout_constraintStart_toEndOf="@id/ivVideoThumbnail"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvVideoTitlePrefix"
                style="?attr/subtext1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resume "
                android:textColor="?attr/onBackgroundSurface3" />

            <TextView
                android:id="@+id/tvVideoTitle"
                style="?attr/subtext1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="3"
                android:textColor="?attr/onSurfaceBgLinks" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbSuggestedVideo"
            style="@style/HorizontalProgressBarVideoDownload"
            android:layout_width="match_parent"
            android:layout_marginTop="4dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressTint="?attr/onSurfaceBlue"
            android:secondaryProgressTint="?attr/onSurfaceBlue" />

        <TextView
            android:id="@+id/tvVideoRemainingDuratiom"
            style="?attr/subtext1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:textColor="?attr/onBackgroundSurface3" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
