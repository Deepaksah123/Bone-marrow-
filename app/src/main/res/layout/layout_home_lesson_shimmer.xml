<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/suggested_card_width"
    android:layout_height="wrap_content"
    android:layout_marginRight="@dimen/pad_large"
    android:background="@drawable/bg_rounded_white_no_stroke"
    android:orientation="vertical">
    <ImageView android:id="@+id/ivSuggestionImage" android:layout_width="match_parent" android:layout_height="@dimen/suggested_card_image_height" android:background="@color/shimmer_background" android:contentDescription="@null" app:srcCompat="@drawable/ic_marrow_logo_m" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="@dimen/pad_feature_card">
        <TextView android:id="@+id/tvVideoTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginRight="6dp" android:layout_weight="1" android:background="@color/shimmer_background" android:fontFamily="sans-serif-medium" android:maxLines="2" android:textSize="14sp" />
        <ImageView android:id="@+id/lesson_completed_view" android:layout_width="@dimen/width_card_status_icon" android:layout_height="@dimen/height_card_status_icon" android:layout_marginLeft="4dp" android:layout_marginTop="2dp" android:layout_marginRight="@dimen/margin_card_status_icons" android:contentDescription="@null" app:srcCompat="@drawable/ic_complete" app:tint="@color/shimmer_background" />
    </LinearLayout>
    <LinearLayout android:id="@+id/bottom_bar" android:layout_width="match_parent" android:layout_height="30dp" android:orientation="horizontal" android:paddingLeft="@dimen/pad_small" android:paddingRight="3dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="3dp" android:layout_marginRight="3dp" android:layout_marginBottom="4dp" android:orientation="horizontal">
            <RatingBar android:layout_width="wrap_content" android:layout_height="wrap_content" android:isIndicator="true" android:numStars="5" android:rating="5" style="?android:attr/ratingBarStyleSmall" />
            <TextView android:layout_width="30dp" android:layout_height="14sp" android:layout_marginLeft="2dp" android:background="@color/shimmer_background" android:maxLines="2" android:textSize="14sp" />
        </LinearLayout>
        <View android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginLeft="3dp" android:layout_marginRight="3dp" android:layout_marginBottom="6dp" android:background="@color/cloudy_blue" />
        <View android:id="@+id/video_info_view" android:layout_width="10dp" android:layout_height="14sp" android:layout_marginLeft="3dp" android:layout_marginRight="3dp" android:layout_marginBottom="4dp" android:background="@color/shimmer_background" />
    </LinearLayout>
</LinearLayout>
