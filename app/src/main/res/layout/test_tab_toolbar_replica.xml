<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/toolbar_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurfaceVariant5"
    android:paddingStart="15dp"
    android:paddingEnd="15dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/action_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingLeft="@dimen/pad_large"
        android:paddingRight="@dimen/pad_large"
        android:contentDescription="@null"
        app:srcCompat="@drawable/ic_arrow_back" />

    <TextView
        android:id="@+id/title_bar_center_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        style="?attr/heading4"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="?attr/colorSurfaceVariant" />

    <ImageView
        android:id="@+id/action_search"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingLeft="@dimen/pad_large"
        android:paddingRight="@dimen/pad_large"
        android:contentDescription="@null"
        app:srcCompat="@drawable/ic_search_revamp" />
</LinearLayout>
