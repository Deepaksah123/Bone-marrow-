<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parentFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/backgroundColor">

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateDrawable="@drawable/rotate_progress_drawable_blue_med"
        android:visibility="gone" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomNudgeContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/snackbar_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/layoutContinueWatchingVideoSuggestionCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <include
            android:id="@+id/layoutContinueWatchingVideoSuggestionCard"
            layout="@layout/layout_video_watch_next_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0dp"
            android:paddingBottom="6dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/rootScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/shell_background">

            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/composeViewAnnouncementBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clSwitchEdition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/composeViewAnnouncementBanner"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tvSwitchToEditionFlipHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/shell_text"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/ivSwitchToEdition"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <ImageView
                    android:id="@+id/ivSwitchToEdition"
                    android:layout_width="10dp"
                    android:layout_height="14dp"
                    android:src="@drawable/chevron_right"
                    android:contentDescription="@null"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/llInternMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/backgroundVariant2"
                android:paddingVertical="@dimen/pad_8dp"
                app:layout_constraintTop_toBottomOf="@id/clSwitchEdition"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tvInternModeStatus"
                    style="?attr/heading6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/margin_16dp"
                    android:text="Intern Mode"
                    android:textColor="?attr/colorOnBackground"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/ibTooltip"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <ImageButton
                    android:id="@+id/ibTooltip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:contentDescription="@null"
                    android:padding="@dimen/pad_8dp"
                    app:srcCompat="@drawable/ic_info"
                    app:tint="?attr/onBackgroundSurface3"
                    app:layout_constraintEnd_toStartOf="@id/switchInternMode"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchInternMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/margin_16dp"
                    android:checked="false"
                    app:thumbTint="?attr/onBackgroundSurface5"
                    app:trackTint="?attr/onSurfaceBgOutline"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:id="@+id/internModeDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:visibility="gone"
                android:background="@color/shell_divider"
                app:layout_constraintTop_toBottomOf="@id/llInternMode"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clInternModeBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/llInternMode"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tvHeaderInternModeBanner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/intern_mode_v2_header"
                    android:textColor="@color/shell_text"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnCloseInternModeBanner"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageButton
                    android:id="@+id/btnCloseInternModeBanner"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Close"
                    android:src="@drawable/ic_close_gopro"
                    android:tint="@color/shell_text"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvInternModeDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/pyt_desc"
                    android:textColor="@color/shell_muted"
                    android:textSize="13sp"
                    app:layout_constraintTop_toBottomOf="@id/tvHeaderInternModeBanner"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <Button
                    android:id="@+id/tvTurnOn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/pyt_turn_on"
                    app:layout_constraintTop_toBottomOf="@id/tvInternModeDescription"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvLearnMore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/nav_learn_more"
                    android:textColor="@color/shell_selected"
                    app:layout_constraintStart_toEndOf="@id/tvTurnOn"
                    app:layout_constraintTop_toTopOf="@id/tvTurnOn"
                    app:layout_constraintBottom_toBottomOf="@id/tvTurnOn" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <HorizontalScrollView
                android:id="@+id/horizontalScrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_16dp"
                android:paddingHorizontal="@dimen/pad_14"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/clInternModeBanner"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include android:id="@+id/layoutSavedVideo" layout="@layout/video_landing_empty_component" />
                    <include android:id="@+id/layoutBookmarkedVideo" layout="@layout/video_landing_empty_component" />
                    <include android:id="@+id/layoutSampleVideo" layout="@layout/video_landing_empty_component" />
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/llFilledHorizontalView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_16dp"
                android:layout_marginHorizontal="@dimen/pad_14"
                android:orientation="horizontal"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/horizontalScrollView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <include android:id="@+id/fixedLayoutSavedVideo" layout="@layout/video_landing_empty_component" />
                <include android:id="@+id/fixedLayoutBookmarkedVideo" layout="@layout/video_landing_empty_component" />
                <include android:id="@+id/fixedLayoutSampleVideo" layout="@layout/video_landing_empty_component" />
            </LinearLayout>

            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/compose_view_deck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/llFilledHorizontalView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <include
                android:id="@+id/layoutVideoWatchNextCard"
                layout="@layout/layout_continue_watching_video_suggestion_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/compose_view_deck"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/llSubjectHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/layoutVideoWatchNextCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    style="?attr/subtext2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_subjects"
                    android:textColor="?attr/onBackgroundSurface3" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvSortByHeader"
                    style="?attr/subtext1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingBottom="@dimen/margin_8dp"
                    android:text="@string/sort_by_v2"
                    android:textColor="?attr/onBackgroundSurface3" />

                <TextView
                    android:id="@+id/sortType"
                    style="?attr/subtext2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/pad_8dp"
                    android:paddingBottom="@dimen/margin_8dp"
                    android:textColor="?attr/colorOnBackground" />

                <ImageView
                    android:id="@+id/ivSortDropDown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/pad_8dp"
                    android:paddingBottom="@dimen/margin_8dp"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/icv_arrow_drop_down"
                    app:tint="?attr/onBackgroundSurface3" />
            </LinearLayout>

            <com.airbnb.epoxy.EpoxyRecyclerView
                android:id="@+id/epoxyRVSubject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="@dimen/pad_14"
                app:layout_constraintTop_toBottomOf="@id/llSubjectHeader"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvReportPiracy"
                style="?attr/subtext1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/margin_40"
                android:padding="@dimen/padding_10"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:text="@string/report_video_piracy"
                android:textColor="?attr/onBackgroundSurface2"
                app:drawableStartCompat="@drawable/ic_report_piracy"
                app:layout_constraintTop_toBottomOf="@id/epoxyRVSubject"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <View
                android:id="@+id/sortOverlay"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:alpha="0.1"
                android:background="#FF000000"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <View
                android:id="@+id/internModeSwitchOverlay"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:alpha="0.8"
                android:background="#FF000000"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/llInternMode"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/llInternModeSwitchView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvInternModeSwitchMsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:textColor="@color/shell_text"
                    android:textSize="14sp" />
            </LinearLayout>

            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupInternModeSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:constraint_referenced_ids="internModeSwitchOverlay,llInternModeSwitchView" />

            <include
                android:id="@+id/tooltipInternModeInfo"
                layout="@layout/video_landing_empty_component"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/llInternMode"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
