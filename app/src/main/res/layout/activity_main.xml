<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shell_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shell_background">

    <FrameLayout
        android:id="@+id/fullContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:layout_marginBottom="64dp"
        android:background="@color/shell_background" />

    <FrameLayout
        android:id="@+id/cvBottomNavigationContainer"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="@color/shell_surface">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/shell_surface" />
    </FrameLayout>

    <!-- Source binds homeAppBar as a container; title text is not verified. -->
    <FrameLayout
        android:id="@+id/homeAppBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:background="@color/shell_surface" />
</FrameLayout>
