<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shell_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shell_background">

    <FrameLayout
        android:id="@+id/fullContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:layout_marginBottom="64dp"
        android:background="@color/shell_background">

        <FrameLayout
            android:id="@+id/upperContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/cvBottomNavigationContainer"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="@color/shell_surface">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/shell_surface" />
    </FrameLayout>

    <!-- Preserve the existing header while its exact original resource hierarchy is traced. -->
    <FrameLayout
        android:id="@+id/homeAppBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:background="@color/shell_surface"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/brand_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="Marrow"
            android:textColor="@color/shell_text"
            android:textSize="18sp"
            android:textStyle="bold" />

    </FrameLayout>
</FrameLayout>
